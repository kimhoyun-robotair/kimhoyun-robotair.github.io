---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
interface Props {
  projects: CollectionEntry<'projects'>[];
  yearHeadingLevel?: 'h2' | 'h3';
}
const { projects, yearHeadingLevel: YearHeading = 'h2' } = Astro.props;
const years = [...new Set(projects.map(({ data }) => data.year))].sort((a, b) => b - a);
const cardHeadingLevel = YearHeading === 'h2' ? 'h3' : 'h4';
---
<div class="project-years">
  {years.map((year) => {
    const entries = projects.filter(({ data }) => data.year === year);
    return <section class="project-year" aria-labelledby={`projects-${year}`} data-year={year}>
      <div class="project-year-heading"><YearHeading id={`projects-${year}`}>{year}</YearHeading><span>{entries.length} {entries.length === 1 ? 'project' : 'projects'}</span></div>
      {entries.map((project) => <ProjectCard project={project} headingLevel={cardHeadingLevel} />)}
    </section>;
  })}
</div>
