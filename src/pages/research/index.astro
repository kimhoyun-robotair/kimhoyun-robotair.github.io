---
import Base from '../../layouts/Base.astro';
import PublicationList from '../../components/PublicationList.astro';
import { profile } from '../../data/profile';
---
<Base title="Research" active="research" description="Publications by Hoyun Kim on planetary robotics, simulation, perception, and autonomy.">
  <div class="shell">
    <header class="page-intro">
      <p class="eyebrow">Publications</p>
      <h1>Research</h1>
      <p>Exploring simulation, perception, and autonomy for robots operating in challenging environments.</p>
      <div class="text-links"><a href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></a></div>
    </header>
    <div class="research-list"><PublicationList headingLevel="h2" /></div>
  </div>
</Base>
