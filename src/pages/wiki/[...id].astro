---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contents from '../../components/Contents.astro';
import { getNotes, getBacklinks, formatDate, statusLabels } from '../../lib/content';
export async function getStaticPaths() {
  return (await getNotes()).map((note) => ({ params: { id: note.id }, props: { note } }));
}
interface Props { note: CollectionEntry<'wiki'>; }
const { note } = Astro.props;
const { Content, headings } = await render(note);
const backlinks = await getBacklinks(note.id);
---
<Base title={note.data.title} description={note.data.description} active="wiki">
  <div class="article-shell">
    <aside class="contents-sidebar"><a class="back-link" href="/wiki/">← Research Notes</a><Contents headings={headings} /></aside>
    <article class="article-main">
      <header class="wiki-article-head">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/wiki/">Research Notes</a><span aria-hidden="true">/</span><a href={`/wiki/?topic=${encodeURIComponent(note.data.topic)}`}>{note.data.topic}</a></nav>
        <div class="note-meta"><span class="status">{statusLabels[note.data.status]}</span><span>Updated <time datetime={formatDate(note.data.updated)}>{formatDate(note.data.updated)}</time></span></div>
        <h1>{note.data.title}</h1>
        <p>{note.data.description}</p>
        <div class="tags">{note.data.tags.map((tag) => <a class="tag" href={`/wiki/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
      </header>
      <div class="prose"><Content /></div>
      <section class="backlinks" aria-labelledby="backlinks-heading"><h2 id="backlinks-heading">Linked from</h2>{backlinks.length ? <ul>{backlinks.map((link) => <li><a href={`/wiki/${link.id}/`}>↗ {link.data.title}</a></li>)}</ul> : <p>No other notes link here yet.</p>}</section>
    </article>
  </div>
</Base>
